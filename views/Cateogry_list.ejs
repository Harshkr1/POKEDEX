<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="/styles.css">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="icon" type="image/png" sizes="32x32" href="/pokeball.png">
<link rel="icon" type="image/png" sizes="16x16" href="/pokeball.png">
    <title><%= cateogry%>></title>
  </head>
  <body>
    <div class="page-container">

      <%- include('./partials/Header') %>
<h2 class="category-heading <%= cateogry %>">
  <span><%= cateogry %></span>
  <small>(<%= pokemonData.length %>)</small>
</h2>

    <div class="cateogry-types-container">

    <% pokemonData.forEach((pokemon) => {%>
        <%- include('./partials/Card', {pokemon:pokemon})%>
    <%});%>
    </div>
</div>
  </body>
</html>
